{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Student",
  "type": "object",
  "properties": {
    "id":         { "type": "integer" },
    "roll_no":    { "type": "string" },
    "name":       { "type": "string" },
    "email":      { "type": "string" },
    "department": { "type": ["string", "null"] },
    "semester":   { "type": ["integer", "null"] },
    "cgpa":       { "type": ["number", "null"] }
  },
  "required": ["name", "roll_no", "email"]
}